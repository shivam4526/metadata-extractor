# Provider selection is automatic: Anthropic is preferred when both keys exist;
# otherwise Groq is used. Set LLM_PROVIDER to force one provider.
LLM_PROVIDER=auto
# Optional Anthropic provider credentials
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Optional Groq provider credentials (used when ANTHROPIC_API_KEY is absent)
GROQ_API_KEY=
# Developer-plan model with strict JSON schema support.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Use direct vision input for PNG/JPG files instead of OCR text.
USE_VISION_FOR_IMAGES=false
# Where successful extraction responses are cached.
CACHE_DIR=.cache/extractions
# Number of documents extracted concurrently by the CLI.
MAX_WORKERS=1
# Prevent Groq entry-tier token bursts; Anthropic ignores this setting.
MIN_REQUEST_INTERVAL_SECONDS=35
